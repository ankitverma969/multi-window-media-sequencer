# ==============================================================================
# Backend Server Environment Variables
# ==============================================================================

# Server Network Configuration
PORT=8080
ENVIRONMENT=development

# MongoDB Connection
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=media_sequencer

# Security & CORS
# Comma-separated list of allowed origins. Do not use wildcard '*' in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Playback & Synchronization Settings
SYNC_LEAD_TIME_MS=1000
SEED_ON_STARTUP=true
