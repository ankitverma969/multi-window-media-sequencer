# ==============================================================================
# EVA Bharat Multi-Window Media Sequencer — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure in your deployment environment / secrets manager.
# NEVER commit real credentials, passwords, or tokens to version control.
# ==============================================================================

# ==============================================================================
# 1. LOCAL DEVELOPMENT CONFIGURATION (Default)
# ==============================================================================
# Backend Server
PORT=8080
ENVIRONMENT=development

# Persistent Database (Local MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=media_sequencer

# Security & CORS (Allowed Frontend Origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Playback & Synchronization Engine
SYNC_LEAD_TIME_MS=1000
SEED_ON_STARTUP=true

# Frontend Client (Direct communication to backend)
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080


# ==============================================================================
# 2. STAGING / PRODUCTION CLOUD DEPLOYMENT (AWS EC2 Direct Ports + Atlas)
# ==============================================================================
# Backend Server
# PORT=8080
# ENVIRONMENT=production

# Persistent Database (MongoDB Atlas Managed Cluster with TLS and Auth)
# MONGODB_URI=mongodb+srv://<app_username>:<strong_password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DATABASE=media_sequencer_prod

# Security & CORS (Allowed Production Origins, e.g. EC2 public IP or domain on port 5173)
# CORS_ALLOWED_ORIGINS=http://<YOUR_EC2_IP>:5173,https://yourdomain.com:5173

# Playback & Synchronization Engine (Production)
# SYNC_LEAD_TIME_MS=1000
# SEED_ON_STARTUP=true

# Frontend Client (Points directly to the Go backend on port 8080)
# VITE_API_URL=http://<YOUR_EC2_IP>:8080
# VITE_WS_URL=ws://<YOUR_EC2_IP>:8080
